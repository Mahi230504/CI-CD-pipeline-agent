# ─── LLM (OpenRouter) ─────────────────────────────────────────────────────────
# Get a key at: openrouter.ai/keys (add credits to your account)
OPENROUTER_API_KEY=
# Override only if self-hosting / proxying OpenRouter.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: legacy direct-Gemini key (no longer required).
GEMINI_API_KEY=

# Model routing — OpenRouter model slugs.
PRIMARY_MODEL=google/gemini-2.5-flash
LIGHT_MODEL=google/gemini-2.5-flash-lite

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained PAT: github.com/settings/tokens → Fine-grained → scope to demo repo only
# Required permissions: Actions(read), Contents(r+w), Metadata(read), PRs(r+w), Workflows(r+w), Checks(read)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Webhook secret: generate with → openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=

# The repo the agent watches
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=cicd-agent-demo

# ─── Agent safety ─────────────────────────────────────────────────────────────
# Max patch attempts before escalating to human (do not exceed 2)
MAX_PATCH_ATTEMPTS=2

# Kill the pipeline if it runs longer than this (seconds)
SESSION_TIMEOUT_SECONDS=180

# Kill the Gemini loop if it exceeds this many turns
MAX_LOOP_ITERATIONS=30

# ─── Resilience: hard timeouts so a run can NEVER hang ────────────────────────
# Every GitHub MCP tool call is bounded by this. On a stalled GitHub edge the
# call fails with a normal error and the pipeline degrades instead of freezing
# — this is the guard against the "stuck at the flakiness check" hang. Seconds.
MCP_CALL_TIMEOUT_SECONDS=45
# Bound on opening the MCP session at startup (a dead edge fails fast).
MCP_CONNECT_TIMEOUT_SECONDS=30
# Per-phase ceiling in the orchestrator. Any phase that exceeds this is
# abandoned and the pipeline takes a safe default (proceed / escalate / skip).
# The patch phase gets a larger budget on top (it waits on the fix PR's CI).
PHASE_TIMEOUT_SECONDS=150

# Minimum seconds between Gemini calls (free tier: keep at 7+)
RATE_LIMIT_DELAY_SECONDS=7

# ─── Notifications (at least one required) ────────────────────────────────────
# Slack: api.slack.com → Your Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Telegram: create bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Infrastructure ───────────────────────────────────────────────────────────
LOG_DIR=./logs
WEBHOOK_PORT=8000

# Set to "true" in production to disable the /trigger test endpoint
PRODUCTION_MODE=false

# ─── Observability (Phase 3) ──────────────────────────────────────────────────
# Log format: `human` (default, terminal-friendly) or `json` (one obj per line)
CICD_AGENT_LOG_FORMAT=human
CICD_AGENT_LOG_LEVEL=INFO

# Daily Gemini cost cap in USD. Set to 0 to disable. Defaults to $1/day.
DAILY_COST_CAP_DOLLARS=1.0
COST_CAP_WARN_PCT=0.8

# Path for the persistent webhook outbox (sqlite). Replayed on startup.
QUEUE_DB_PATH=./queue.sqlite3

# ─── CD pipeline (Phase 3) ────────────────────────────────────────────────────
# Name of the GitHub Codespace the deployer SSHes into. Get it from
# `gh codespace list` — looks like `potential-giggle-px7x7r4x5xwhrq4`.
# Leave empty to disable CD entirely; the agent runs CI-only.
CODESPACE_NAME=

# Absolute path to the demo repo checkout inside the codespace.
CODESPACE_WORKDIR=/workspaces/cicd-agent-demo

# Public HTTPS URL of the codespace's port 8000 (the demo backend).
# Used by health_monitor AND event_publisher. No trailing slash needed.
# Example: https://potential-giggle-px7x7r4x5xwhrq4-8000.app.github.dev
BACKEND_BASE_URL=

# Shared secret for POST /internal/agent-event — must match the demo
# backend's AGENT_SHARED_SECRET. Empty = events are not published, but the
# rest of CD still works (deploy / health / rollback).
AGENT_SHARED_SECRET=

# The GHCR image repository. The deployer combines this with the merge SHA:
#   API_IMAGE=<DEPLOY_IMAGE_REPOSITORY>:<short_sha>
# Example: ghcr.io/mahi230504/inventory-flow
DEPLOY_IMAGE_REPOSITORY=

# The .env variable name docker-compose.yml in the demo repo interpolates
# for the api/worker `image:` line. Don't change unless you've also changed
# the compose file.
DEPLOY_IMAGE_ENV_VAR=API_IMAGE

# Name of the release workflow whose successful runs trigger deploys.
# Must match `name:` in .github/workflows/release.yml.
RELEASE_WORKFLOW_NAME=release

# How long the health monitor waits for /health to go green AND /version to
# report the new SHA before declaring the deploy failed.
DEPLOY_HEALTH_TIMEOUT_SECONDS=90
DEPLOY_HEALTH_POLL_INTERVAL_SECONDS=3.0

# If true (default), a failed health check immediately re-deploys the
# previous IMAGE_TAG. Set to false to keep the bad deploy live for debugging.
AUTO_ROLLBACK_ENABLED=true
